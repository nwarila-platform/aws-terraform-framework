# Copy this file to terraform.tfvars and replace every REPLACE_ME value before
# planning or applying. Values here are placeholders, not deployable IDs.

environment = "dev"

# Required for a real apply. The readiness gate uses SSH for both Linux and
# Windows, and the map keys must match all_systems[*].key_name. Windows logs in
# as Administrator; WinRM is decommissioned.
readiness_private_key_paths = {
  "app-linux-key" = "/secure/path/REPLACE_ME-app-linux-key.pem"
  "win-admin-key" = "/secure/path/REPLACE_ME-win-admin-key.pem"
}

all_systems = [
  {
    region               = "us_east_1"
    hostname             = "app01"
    availability_zone    = "us-east-1a"
    subnet_id            = "subnet-REPLACE_ME"
    key_name             = "app-linux-key"
    iam_instance_profile = "ec2-REPLACE_ME-profile"
    aws_kms_alias        = "ebs-REPLACE_ME"
    ami                  = "app-linux"
    refresh              = false
    instance_type        = "m6i.large"
    readiness_user       = null
    readiness_gate       = true
    imds_hop_limit       = 1
    set_state            = null

    tags = {
      Function = "app"
      Backup   = true
    }

    root_block_device = {
      delete_on_termination = true
      iops                  = null
      tags                  = {}
      throughput            = null
      volume_type           = "gp3"
      volume_size           = "100"
    }

    ebs_block_devices = []

    network_interfaces = [
      {
        # Null lets AWS pick a free address from the subnet CIDR, and the aws_instances output
        # reports whichever address it picked. Prefer this: a generated Ansible inventory reads
        # the address back after apply, so nothing needs it hand-allocated up front.
        private_ip      = null
        security_groups = ["sg-REPLACE_ME"]
        # Non-null ingress and egress declare this interface's own "app01-eni-0-sg" group. Its
        # description and tags come from this same interface, and the framework attaches it only
        # here. security_groups remains exclusively for pre-created group IDs.
        description    = "app01 inbound firewall."
        interface_type = null
        ingress = [
          {
            description                  = "HTTPS from the internal load-balancer subnet"
            ip_protocol                  = "tcp"
            from_port                    = 443
            to_port                      = 443
            cidr_ipv4                    = "10.0.0.0/16"
            cidr_ipv6                    = null
            prefix_list_id               = null
            referenced_security_group_id = null
          }
        ]
        egress = [
          {
            description                  = "All outbound"
            ip_protocol                  = "-1"
            from_port                    = null
            to_port                      = null
            cidr_ipv4                    = "0.0.0.0/0"
            cidr_ipv6                    = null
            prefix_list_id               = null
            referenced_security_group_id = null
          }
        ]
        tags = {}
      }
    ]

    associate_public_ip = false
  },
  {
    region               = "us_east_1"
    hostname             = "win01"
    availability_zone    = "us-east-1a"
    subnet_id            = "subnet-REPLACE_ME"
    key_name             = "win-admin-key"
    iam_instance_profile = "ec2-REPLACE_ME-profile"
    aws_kms_alias        = "ebs-REPLACE_ME"
    ami                  = "windows_server_2025_base"
    refresh              = false
    instance_type        = "m6i.large"
    readiness_user       = null
    readiness_gate       = true
    imds_hop_limit       = 1
    set_state            = null

    tags = {
      Function = "app"
      Backup   = true
    }

    root_block_device = {
      delete_on_termination = true
      iops                  = null
      tags                  = {}
      throughput            = null
      volume_type           = "gp3"
      volume_size           = "100"
    }

    ebs_block_devices = []

    network_interfaces = [
      {
        # The deliberate-pin form, for an interface something outside this framework addresses by
        # IP. A pinned address must be a bare IPv4 address, unique within its subnet, and - when
        # the system sits in a managed_networks subnet - inside that subnet_cidr and clear of the
        # five addresses AWS reserves in every subnet (the first four and the last).
        private_ip      = "10.0.2.10"
        security_groups = ["sg-REPLACE_ME"]
        description     = null
        interface_type  = null
        # Paired nulls are the off switch: attach only the pre-created group above.
        ingress = null
        egress  = null
        tags    = {}
      }
    ]

    associate_public_ip = false
  }
]

# See docs/reference/terraform.md for fully-specified database and load balancer
# object schemas when these collections are populated.
all_databases      = []
all_load_balancers = []

# Deployment identity (optional). The deploy workflow injects this automatically as
# TF_VAR_resource_metadata (see docs/reference/runner-protocol.md); set it manually only to
# exercise the tagging path. Unset (the default) emits zero tags.
# resource_metadata = {
#   repository    = "nwarila-platform/aws-terraform-framework"
#   repository_id = "123456789"
#   stack         = "wsus-poc-us-east-1"
#   owner         = "platform-engineering"
#   commit_sha    = "0123456789abcdef0123456789abcdef01234567"
#   run_id        = "1234567890"
# }
