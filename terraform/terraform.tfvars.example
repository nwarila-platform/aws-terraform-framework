environment = "DEV"

all_systems = [
  {
    /* Required Parameters */
    hostname               = "example-app-01"
    region                 = "us-west-2"
    availability_zone      = "us-west-2c"
    # Match this subnet to the selected availability zone when adapting the example.
    subnet_id              = "subnet-000a0000000000aaa"
    key_name               = "example-admin-key"
    iam_instance_profile   = "example-instance-profile"
    aws_kms_alias          = "aws/ebs"
    refresh                = false

    /* Optional Parameters */
    ami                    = "red_hat_enterprise_linux_8"
    instance_type          = "m6i.xlarge"
    set_state              = "running"


    # AWS AMI Module doesn't seem to like this being a variable, more testing needed.
    # !Error: Invalid Expression - A static list expression is required.
    # lifecycle = {
    #   ignore_changes = []
    # }

    # Operating System Volume
    root_block_device = {
      volume_type           = "gp3"
      volume_size           = "100"
      delete_on_termination = true
      tags = {}
    }

    network_interfaces = [
      {
        description     = "Primary Network Interface"
        private_ip      = "10.0.0.10"
        security_groups = [
            "sg-000a000aa000aaaaa",
            "sg-0aaa00a0a000a0000"
        ]
      }
    ]

    ebs_block_devices = [
      {
        volume_type           = "gp3"
        volume_size           = "25"
        delete_on_termination = false
      }
    ]

    tags = {
      #Name        = <Set Automatically From 'hostname'>
      #OS          = <Set Automatically From 'ami'>
      Backup       = true
      Function     = "Jenkins Server"
      #Terraform   = <Statically Set To 'True'>
      #Environment = <Set Automatically From 'var.environment'>
    }
  }
]

all_load_balancers = [
  {
    region       = "us-west-2"
    resource_key = "example_application_lb"
    name         = "example-app-lb"
    subnets      = ["subnet-000a0000000000aaa", "subnet-000a0000000000bbb"]

    security_groups = [
      "sg-000a000aa000aaaaa"
    ]

    target_groups = [
      {
        resource_key = "jenkins"
        function     = "Jenkins Server"
        vpc_id       = "vpc-000a0000000000aaa"
        port         = 8080
        protocol     = "HTTP"

        health_check = {
          path = "/login"
        }
      }
    ]

    listeners = [
      {
        resource_key    = "https"
        port            = 443
        protocol        = "HTTPS"
        certificate_arn = "arn:aws:acm:us-west-2:111122223333:certificate/EXAMPLE"

        default_action = {
          type             = "forward"
          target_group_key = "jenkins"
        }

        rules = [
          {
            resource_key = "jenkins_path"
            priority     = 100

            action = {
              type             = "forward"
              target_group_key = "jenkins"
            }

            conditions = [
              {
                path_pattern = ["/jenkins/*"]
              }
            ]
          }
        ]
      },
      {
        resource_key = "http"
        port         = 80
        protocol     = "HTTP"

        default_action = {
          type = "redirect"

          redirect = {
            port        = "443"
            protocol    = "HTTPS"
            status_code = "HTTP_301"
          }
        }
      }
    ]

    tags = {
      Function = "Example Application Load Balancer"
    }
  }
]
