environment = "${E2E_PROJECT}"

refresh_serial = ${E2E_REFRESH_SERIAL}

# Public AMIs use different default SSH users. /var/tmp is the common writable
# exec path for the Linux readiness script across AL2023 ec2-user and Ubuntu.
readiness_linux_script_dir = "/var/tmp"

readiness_private_key_paths = {
  "${E2E_KEY_NAME}" = "${E2E_READINESS_KEY_PATH}"
}

aws_config = {
  regions = ["us_east_1", "us_west_2"]
}

all_systems = [
  {
    region               = "us_east_1"
    hostname             = "e2e-lin-raw"
    availability_zone    = "${E2E_AVAILABILITY_ZONE}"
    subnet_id            = "${E2E_PRIVATE_SUBNET_ID}"
    key_name             = "${E2E_KEY_NAME}"
    iam_instance_profile = "${E2E_FRAMEWORK_INSTANCE_PROFILE}"
    aws_kms_alias        = "${E2E_KMS_ALIAS_NAME}"
    ami                  = "${E2E_AL2023_AMI_ID}"
    instance_type        = "t3.micro"

    root_block_device = {
      volume_size = "8"
      tags = {
        Project = "${E2E_PROJECT}"
      }
    }

    ebs_block_devices = [
      {
        volume_size  = "1"
        skip_destroy = false
        tags = {
          Project = "${E2E_PROJECT}"
        }
      },
      {
        volume_size  = "1"
        skip_destroy = false
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]

    tags = {
      Function = "e2e-lin-raw"
      Project  = "${E2E_PROJECT}"
    }

    network_interfaces = [
      {
        private_ip      = "10.42.10.10"
        security_groups = ["${E2E_FRAMEWORK_SECURITY_GROUP_ID}"]
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]
  },
  {
    region               = "us_east_1"
    hostname             = "e2e-lin-ubu"
    availability_zone    = "${E2E_AVAILABILITY_ZONE}"
    subnet_id            = "${E2E_PRIVATE_SUBNET_ID}"
    key_name             = "${E2E_KEY_NAME}"
    iam_instance_profile = "${E2E_FRAMEWORK_INSTANCE_PROFILE}"
    aws_kms_alias        = "${E2E_KMS_ALIAS_NAME}"
    ami                  = "${E2E_UBUNTU_AMI_ID}"
    instance_type        = "t3.micro"
    readiness_user       = "ubuntu"
    set_state            = "stopped"

    root_block_device = {
      volume_size = "8"
      tags = {
        Project = "${E2E_PROJECT}"
      }
    }

    ebs_block_devices = [
      {
        volume_size  = "1"
        skip_destroy = false
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]

    tags = {
      Backup   = false
      Function = "e2e-lin-ubu"
      Project  = "${E2E_PROJECT}"
    }

    network_interfaces = [
      {
        private_ip      = "10.42.10.11"
        security_groups = ["${E2E_FRAMEWORK_SECURITY_GROUP_ID}"]
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]
  },
  {
    region               = "us_east_1"
    hostname             = "e2e-lin-fam"
    availability_zone    = "${E2E_AVAILABILITY_ZONE}"
    subnet_id            = "${E2E_PRIVATE_SUBNET_ID}"
    key_name             = "${E2E_KEY_NAME}"
    iam_instance_profile = "${E2E_FRAMEWORK_INSTANCE_PROFILE}"
    aws_kms_alias        = "${E2E_KMS_ALIAS_NAME}"
    ami                  = "app-linux"
    instance_type        = "t3.micro"

    root_block_device = {
      volume_size = "8"
      tags = {
        Project = "${E2E_PROJECT}"
      }
    }

    tags = {
      Function = "e2e-lin-fam"
      Project  = "${E2E_PROJECT}"
    }

    network_interfaces = [
      {
        private_ip      = "10.42.10.12"
        security_groups = ["${E2E_FRAMEWORK_SECURITY_GROUP_ID}"]
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]
  },
  {
    region               = "us_east_1"
    hostname             = "e2e-lin-ver"
    availability_zone    = "${E2E_AVAILABILITY_ZONE}"
    subnet_id            = "${E2E_PRIVATE_SUBNET_ID}"
    key_name             = "${E2E_KEY_NAME}"
    iam_instance_profile = "${E2E_FRAMEWORK_INSTANCE_PROFILE}"
    aws_kms_alias        = "${E2E_KMS_ALIAS_NAME}"
    ami                  = "app-linux:1"
    instance_type        = "t3.micro"

    root_block_device = {
      volume_size = "8"
      tags = {
        Project = "${E2E_PROJECT}"
      }
    }

    tags = {
      Function = "e2e-lin-ver"
      Project  = "${E2E_PROJECT}"
    }

    network_interfaces = [
      {
        private_ip      = "10.42.10.13"
        security_groups = ["${E2E_FRAMEWORK_SECURITY_GROUP_ID}"]
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]
  },
  {
    region               = "us_east_1"
    hostname             = "e2e-win-25"
    availability_zone    = "${E2E_AVAILABILITY_ZONE}"
    subnet_id            = "${E2E_PRIVATE_SUBNET_ID}"
    key_name             = "${E2E_KEY_NAME}"
    iam_instance_profile = "${E2E_FRAMEWORK_INSTANCE_PROFILE}"
    aws_kms_alias        = "${E2E_KMS_ALIAS_NAME}"
    ami                  = "windows_server_2025_base"
    instance_type        = "t3.micro"
    refresh              = true

    root_block_device = {
      volume_size = "30"
      tags = {
        Project = "${E2E_PROJECT}"
      }
    }

    ebs_block_devices = [
      {
        volume_size  = "1"
        skip_destroy = false
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]

    tags = {
      Function = "e2e-win-25"
      Project  = "${E2E_PROJECT}"
    }

    network_interfaces = [
      {
        private_ip      = "10.42.10.14"
        security_groups = ["${E2E_FRAMEWORK_SECURITY_GROUP_ID}"]
        tags = {
          Project = "${E2E_PROJECT}"
        }
      }
    ]
  }
]

all_databases = ${E2E_ALL_DATABASES}

all_load_balancers = ${E2E_ALL_LOAD_BALANCERS}
