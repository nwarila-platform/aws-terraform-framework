# Copy this file to terraform.tfvars and replace every REPLACE_ME value before
# planning or applying. Values here are placeholders, not deployable IDs.

# Exactly one of dev, test, or prod (lowercase).
environment = "dev"

all_systems = [
  {
    region                     = "us_east_1"
    hostname                   = "app01"
    availability_zone          = "us-east-1a"
    subnet_id                  = "subnet-replace-me"
    key_name                   = "app-linux-key"
    iam_instance_profile       = "ec2-REPLACE_ME-profile"
    aws_kms_alias              = "ebs-REPLACE_ME"
    ami                        = "app-linux"
    refresh                    = false
    instance_type              = "m6i.large"
    connection_type            = null
    readiness_user             = null
    readiness_command          = null
    readiness_script_dir       = null
    readiness_private_key_path = "/secure/path/REPLACE_ME-app-linux-key.pem"
    readiness_gate             = true
    imds_hop_limit             = 1
    set_state                  = null

    tags = {
      Function = "app"
      Backup   = true
    }

    root_block_device = {
      delete_on_termination = true
      iops                  = null
      tags                  = {}
      throughput            = null
      volume_type           = "gp3"
      volume_size           = "100"
    }

    ebs_block_devices = []

    ami_block_device_overrides = []

    network_interfaces = [
      {
        # Null lets AWS pick a free address from the subnet CIDR, and the aws_instances output
        # reports whichever address it picked. Prefer this: a generated Ansible inventory reads
        # the address back after apply, so nothing needs it hand-allocated up front.
        private_ip = null
        # Null is the off switch, and [] means the same: this interface carries the one address
        # above and nothing more. An interface needs further addresses only when software on it
        # owns an address the operating system itself never configures.
        additional_private_ips = null
        security_groups        = ["sg-REPLACE_ME"]
        # Non-null ingress and egress declare this interface's own "app01-eni-0-sg" group. Its
        # description and tags come from this same interface, and the framework attaches it only
        # here. security_groups remains exclusively for pre-created group IDs.
        description    = "app01 inbound firewall."
        interface_type = null
        ingress = [
          {
            description                  = "HTTPS from the internal load-balancer subnet"
            ip_protocol                  = "tcp"
            from_port                    = 443
            to_port                      = 443
            cidr_ipv4                    = "10.0.0.0/16"
            prefix_list_id               = null
            referenced_security_group_id = null
          }
        ]
        egress = [
          {
            description                  = "All outbound"
            ip_protocol                  = "-1"
            from_port                    = null
            to_port                      = null
            cidr_ipv4                    = "0.0.0.0/0"
            prefix_list_id               = null
            referenced_security_group_id = null
          }
        ]
        tags = {}
      }
    ]

    associate_public_ip = false
  },
  {
    region                     = "us_east_1"
    hostname                   = "win01"
    availability_zone          = "us-east-1a"
    subnet_id                  = "subnet-replace-me"
    key_name                   = "win-admin-key"
    iam_instance_profile       = "ec2-REPLACE_ME-profile"
    aws_kms_alias              = "ebs-REPLACE_ME"
    ami                        = "windows_server_2025_base"
    refresh                    = false
    instance_type              = "m6i.large"
    connection_type            = null
    readiness_user             = null
    readiness_command          = null
    readiness_script_dir       = null
    readiness_private_key_path = "/secure/path/REPLACE_ME-win-admin-key.pem"
    readiness_gate             = true
    imds_hop_limit             = 1
    set_state                  = null

    tags = {
      Function = "app"
      Backup   = true
    }

    root_block_device = {
      delete_on_termination = true
      iops                  = null
      tags                  = {}
      throughput            = null
      volume_type           = "gp3"
      volume_size           = "100"
    }

    ebs_block_devices = []

    ami_block_device_overrides = []

    network_interfaces = [
      {
        # The deliberate-pin form, for an interface something outside this framework addresses by
        # IP. A pinned address must be a bare IPv4 address, unique within its subnet, inside the
        # subnet's real CIDR, and clear of the five addresses AWS reserves in every subnet (the
        # first four and the last). All of that is checked at plan time against the subnet itself.
        private_ip = "10.0.2.10"
        # Further addresses carried alongside the pinned one, for software that owns an address the
        # operating system never configures - a Windows failover cluster brings its client access
        # point online on one of these. Pinning private_ip is required alongside them: the first
        # address is the one AWS marks primary and the operating system configures, so every address
        # below stays a secondary. They share the primary's subnet-uniqueness rule.
        additional_private_ips = ["10.0.2.100", "10.0.2.101"]
        security_groups        = ["sg-REPLACE_ME"]
        description            = null
        interface_type         = null
        # Paired nulls are the off switch: attach only the pre-created group above.
        ingress = null
        egress  = null
        tags    = {}
      }
    ]

    associate_public_ip = false
  }
]

# A shared volume is independent of either system lifecycle. Every attachment chooses its own
# device index, so the same slot resolves to /dev/sdd on app01 and xvdd on win01.
shared_ebs_volumes = {
  cluster-data = {
    region            = "us_east_1"
    availability_zone = "us-east-1a"
    aws_kms_alias     = "ebs-REPLACE_ME"
    iops              = "3000"
    volume_size       = "100"
    tags = {
      Function = "cluster data"
    }
    attachments = [
      {
        hostname     = "app01"
        device_index = 0
      },
      {
        hostname     = "win01"
        device_index = 0
      }
    ]
  }
}

# See docs/reference/terraform.md for fully-specified database and load balancer
# object schemas when these collections are populated.
all_databases      = []
all_load_balancers = []

# Where the Windows SSH bootstrap fetches Feature-on-Demand cabs to install OpenSSH.Server on
# images that ship without it (Server 2022): one account-wide bucket, the region it lives in, and
# the prefix under which cabs sit as <key_prefix>/<OS build>/<package>.cab. Null disables the
# install step. Instance roles need s3:GetObject on <key_prefix>/* in the bucket.
#   windows_fod_source = { bucket = "123456789012-apprepo", region = "us-east-1", key_prefix = "fod" }
windows_fod_source = null

# Deployment identity is NOT set here. The deploy workflow passes repository, repository_id,
# commit_sha, and run_id as command-line -var arguments (see docs/reference/runner-protocol.md),
# which outrank every tfvars source - so a value file cannot restate them. All four are required:
# a plan without them fails rather than emitting untagged resources.
